# Plantilla de variables. NO pongas claves acá: este archivo sí se sube a GitHub.
# Copialo como .env.local (que NO se sube) y completá los valores ahí,
# o cargalos en Vercel → tu proyecto → Settings → Environment Variables.

# Mercado Pago (credenciales de PRUEBA) → mercadopago.com.ar/developers → Tus integraciones → Chumbo
MP_ACCESS_TOKEN=
# Clave secreta del webhook → misma aplicación → Webhooks → "Clave secreta"
MP_WEBHOOK_SECRET=
# Dejalo en false hasta que decidas pasar a producción
MP_PERMITIR_PRODUCCION=false

# Supabase → proyecto "chumbo" → Project Settings → API
SUPABASE_URL=
# La clave "service_role" (secreta: sólo en el servidor, nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la app (en Vercel, ej.: https://chumbo.vercel.app)
NEXT_PUBLIC_SITE_URL=
